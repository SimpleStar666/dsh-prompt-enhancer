{
  "name": "dsh-prompt-enhancer",
  "version": "0.3.1",
  "description": "DSH 输入框一键提示词增强：模型改写草稿并回填，发送前可审阅；不自动发送。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "src", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "docs", "tools", "test"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node tools/check-plugin-contract.mjs",
    "verify": "node --test test/*.test.mjs && node tools/check-plugin-contract.mjs && node --check client.js && node --check index.js"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "prompt", "enhancer"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
