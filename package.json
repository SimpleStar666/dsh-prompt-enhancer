{
  "name": "dsh-prompt-enhancer",
  "version": "0.1.0",
  "description": "在 DSH 右侧栏把原始想法增强为清晰、可执行的提示词。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "engines": { "node": ">=22.19.0" },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "prompt", "enhancer"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
