{
  "name": "dsh-prompt-enhancer",
  "version": "0.2.0",
  "description": "在 DSH 右侧栏查看原文线索与可选澄清，将真实回答加入草稿；本地规则，不调用模型。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "src", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "docs", "tools", "test"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node tools/check-plugin-contract.mjs",
    "verify": "node --test test/*.test.mjs && node tools/check-plugin-contract.mjs && node --check client.js && node --check index.js"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "prompt", "enhancer"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
